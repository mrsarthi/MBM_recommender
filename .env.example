# TMDB API Key (Required for movie metadata, posters, and recommendations)
# Get a free key at: https://www.themoviedb.org/settings/api
TMDB_key=YOUR_TMDB_API_KEY_HERE

# Google Gemini API Key (Required for AI mood/vibe parsing and search expansion)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Your Letterboxd Username (Optional: used for 1-click diary & watchlist sync)
# e.g., sarthi_watcher
LETTERBOXD_USERNAME=your_letterboxd_username_here

# Neon PostgreSQL connection string (required: stores users, diary, watchlist)
# Create a free database at https://neon.tech and copy the POOLED connection string
# (the host contains "-pooler"). The pooled endpoint is required - this app serves
# each request on its own thread and will exhaust direct connections otherwise.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
